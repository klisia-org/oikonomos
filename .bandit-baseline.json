      "code": "157 \t# plain Draft \u2192 Submitted transition on a free / no-pay-required doc.\n158 \tsql = f\"\"\"\n159         SELECT\n160             cei.name AS cei,\n161             cei.student_ce AS student,\n162             cei.course_data AS course,\n163             cei.program_data AS program,\n164             mark.owner AS marked_paid_by,\n165             mark.creation AS marked_paid_on,\n166             cei.total_invoiced,\n167             cei.total_paid,\n168             cei.paid_percent,\n169             (\n170                 SELECT COUNT(*) FROM `tabSales Invoice` si\n171                 WHERE si.custom_cei = cei.name\n172                   AND si.docstatus = 1\n173                   AND si.is_return = 0\n174             ) AS si_submitted,\n175             (\n176                 SELECT COUNT(*) FROM `tabSales Invoice` si\n177                 WHERE si.custom_cei = cei.name\n178                   AND si.docstatus = 2\n179             ) AS si_cancelled,\n180             (\n181                 SELECT COUNT(*) FROM `tabSales Invoice` si\n182                 WHERE si.custom_cei = cei.name\n183                   AND si.is_return = 1\n184             ) AS si_returns,\n185             1 AS row_count\n186         FROM `tabCourse Enrollment Individual` cei\n187         JOIN (\n188             SELECT c.reference_name, c.owner, c.creation\n189             FROM `tabComment` c\n190             JOIN (\n191                 SELECT reference_name, MAX(creation) AS max_creation\n192                 FROM `tabComment`\n193                 WHERE comment_type = 'Workflow'\n194                   AND reference_doctype = 'Course Enrollment Individual'\n195                   AND content = 'Submitted'\n196                 GROUP BY reference_name\n197             ) latest\n198               ON latest.reference_name = c.reference_name\n199              AND latest.max_creation = c.creation\n200             WHERE c.comment_type = 'Workflow'\n201               AND c.reference_doctype = 'Course Enrollment Individual'\n202               AND c.content = 'Submitted'\n203         ) mark ON mark.reference_name = cei.name\n204         WHERE {where}\n205           AND EXISTS (\n206               SELECT 1 FROM `tabComment` ap\n207               WHERE ap.comment_type = 'Workflow'\n208                 AND ap.reference_doctype = 'Course Enrollment Individual'\n209                 AND ap.reference_name = cei.name\n210                 AND ap.content = 'Awaiting Payment'\n211                 AND ap.creation < mark.creation\n212           )\n213           AND NOT EXISTS (\n214               SELECT 1 FROM `tabSales Invoice` si\n215               WHERE si.custom_cei = cei.name\n216                 AND si.docstatus = 1\n217                 AND si.is_return = 0\n218                 AND si.outstanding_amount <= 0\n219           )\n220         ORDER BY mark.creation DESC\n221     \"\"\"\n222 \n",
